  "font_size": 9,
  "format_data": null,
  "html": "<style>\n  @page { size: A4; margin: 0; }\n  html, body, .print-format-gutter, .print-format { background: #EFEDE6 !important; margin: 0 !important; padding: 0 !important; width: 100% !important; max-width: 100% !important; box-shadow: none !important; }\n  .print-format { border: none !important; }\n  .swiss { background: #EFEDE6; color: #111; font-family: Helvetica, Arial, sans-serif; font-size: 9pt; line-height: 1.45; width: 100%; box-sizing: border-box; padding: 16mm 14mm; min-height: 297mm; -webkit-print-color-adjust: exact; print-color-adjust: exact; }\n  .swiss table { width: 100%; border-collapse: collapse; }\n  .swiss td { vertical-align: top; }\n  .swiss .rule td { border-top: 1px solid #111; font-size: 0; line-height: 0; height: 1px; padding: 0; }\n  .swiss .sp td { height: 14px; font-size: 0; line-height: 0; padding: 0; }\n  .swiss .brand { font-size: 21pt; font-weight: bold; letter-spacing: -0.5px; }\n  .swiss .doclabel { font-size: 15pt; font-weight: bold; color: #E5231B; text-align: right; }\n  .swiss .lbl { font-weight: bold; font-size: 8.5pt; padding-bottom: 4px; }\n  .swiss .muted { color: #444; }\n  .swiss .r { text-align: right; }\n  .swiss .c { text-align: center; }\n  .swiss .items thead td { font-weight: bold; font-size: 8.5pt; padding: 0 4px 7px 0; border-bottom: 1px solid #111; }\n  .swiss .items tbody td { padding: 7px 4px 7px 0; border-bottom: 1px solid #D8D4C7; }\n  .swiss .totals td { padding: 6px 0; border-bottom: 1px solid #D8D4C7; }\n  .swiss .totals .grand td { border-bottom: none; border-top: 1px solid #111; font-weight: bold; }\n</style>\n\n<div class=\"swiss\">\n\n  <table>\n    <tr>\n      <td class=\"brand\">{{ doc.company.upper() }}</td>\n      <td class=\"doclabel\">QUOTATION</td>\n    </tr>\n  </table>\n\n  <table class=\"sp\"><tr><td></td></tr></table>\n\n  {% set caddr = frappe.db.get_value(\"Address\", {\"is_your_company_address\": 1, \"link_name\": doc.company}, [\"address_line1\", \"address_line2\", \"city\", \"state\", \"pincode\", \"country\"], as_dict=True) %}\n  {% set comp = frappe.get_doc(\"Company\", doc.company) %}\n\n  <table>\n    <tr>\n      <td width=\"50%\">\n        <div class=\"lbl\">{{ doc.company }}</div>\n        <div class=\"muted\">\n          {% if caddr %}\n            {{ caddr.address_line1 or \"\" }}<br>\n            {% if caddr.address_line2 %}{{ caddr.address_line2 }}<br>{% endif %}\n            {{ caddr.city or \"\" }}{% if caddr.state %}, {{ caddr.state }}{% endif %} {{ caddr.pincode or \"\" }}<br>\n            {{ caddr.country or \"\" }}\n          {% endif %}\n        </div>\n      </td>\n      <td width=\"50%\">\n        <div class=\"lbl\">Contact</div>\n        <div class=\"muted\">\n          {% if comp.website %}{{ comp.website }}<br>{% endif %}\n          {% if comp.phone_no %}{{ comp.phone_no }}<br>{% endif %}\n          {% if comp.email %}{{ comp.email }}{% endif %}\n        </div>\n      </td>\n    </tr>\n  </table>\n\n  <table class=\"sp\"><tr><td></td></tr></table>\n  <table class=\"rule\"><tr><td></td></tr></table>\n  <table class=\"sp\"><tr><td></td></tr></table>\n\n  <table>\n    <tr>\n      <td width=\"25%\"><div class=\"lbl\">Quotation Amount</div><div class=\"muted\">{{ frappe.utils.fmt_money(doc.grand_total, currency=doc.currency) }}</div></td>\n      <td width=\"25%\"><div class=\"lbl\">Valid Till</div><div class=\"muted\">{{ frappe.utils.formatdate(doc.valid_till, \"d MMM, yyyy\") if doc.valid_till else \"-\" }}</div></td>\n      <td width=\"25%\"><div class=\"lbl\">Quotation #</div><div class=\"muted\">{{ doc.name }}</div></td>\n      <td width=\"25%\"><div class=\"lbl\">Date</div><div class=\"muted\">{{ frappe.utils.formatdate(doc.transaction_date, \"d MMM, yyyy\") }}</div></td>\n    </tr>\n  </table>\n\n  <table class=\"sp\"><tr><td></td></tr></table>\n  <table class=\"rule\"><tr><td></td></tr></table>\n  <table class=\"sp\"><tr><td></td></tr></table>\n\n  <table>\n    <tr>\n      <td width=\"50%\">\n        <div class=\"lbl\">Quotation To</div>\n        <div class=\"muted\">{{ doc.customer_name or doc.party_name }}<br>{{ doc.address_display or \"\" }}</div>\n      </td>\n      <td width=\"50%\">\n        <div class=\"lbl\">Shipping To</div>\n        <div class=\"muted\">{{ doc.shipping_address or doc.address_display or \"\" }}</div>\n      </td>\n    </tr>\n  </table>\n\n  <table class=\"sp\"><tr><td></td></tr></table>\n  <table class=\"rule\"><tr><td></td></tr></table>\n  <table class=\"sp\"><tr><td></td></tr></table>\n\n  <table class=\"items\">\n    <thead>\n      <tr>\n        <td width=\"4%\">#</td>\n        <td width=\"46%\">Desc. of Goods/Services</td>\n        <td width=\"12%\" class=\"r\">Qty.</td>\n        <td width=\"14%\" class=\"r\">Rate ({{ doc.currency }})</td>\n        <td width=\"8%\" class=\"c\">Dis.</td>\n        <td width=\"16%\" class=\"r\">Total ({{ doc.currency }})</td>\n      </tr>\n    </thead>\n    <tbody>\n      {% for item in doc.items %}\n      <tr>\n        <td>{{ loop.index }}</td>\n        <td>\n          {{ item.item_name }}\n          {% if item.description and item.description != item.item_name %}\n            <div class=\"muted\" style=\"font-size:8pt\">{{ item.description | striptags }}</div>\n          {% endif %}\n        </td>\n        <td class=\"r\">{{ \"%.1f\"|format(item.qty) }} {{ item.uom }}</td>\n        <td class=\"r\">{{ \"{:,.0f}\".format(item.rate) }}</td>\n        <td class=\"c\">{{ \"{:.0f}\".format(item.discount_percentage or 0) }}</td>\n        <td class=\"r\">{{ \"{:,.0f}\".format(item.amount) }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n\n  <table class=\"sp\"><tr><td></td></tr></table>\n\n  <table>\n    <tr>\n      <td width=\"58%\">\n        <div class=\"lbl\">In Words</div>\n        <div class=\"muted\">{{ doc.in_words or \"\" }}</div>\n        {% if doc.terms %}\n          <div class=\"lbl\" style=\"padding-top:12px\">Terms</div>\n          <div class=\"muted\" style=\"font-size:8pt\">{{ doc.terms | striptags }}</div>\n        {% endif %}\n      </td>\n      <td width=\"8%\"></td>\n      <td width=\"34%\">\n        <table class=\"totals\">\n          <tr><td>Sub Total</td><td class=\"r\">{{ \"{:,.0f}\".format(doc.net_total) }}</td></tr>\n          {% for tax in doc.taxes %}\n          <tr><td>{{ tax.description | striptags }}</td><td class=\"r\">{{ \"{:,.0f}\".format(tax.tax_amount) }}</td></tr>\n          {% endfor %}\n          {% if doc.discount_amount %}\n          <tr><td>Discount</td><td class=\"r\">-{{ \"{:,.0f}\".format(doc.discount_amount) }}</td></tr>\n          {% endif %}\n          <tr class=\"grand\"><td>Total</td><td class=\"r\">{{ \"{:,.0f}\".format(doc.grand_total) }}</td></tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n\n  <table style=\"margin-top:40px\">\n    <tr>\n      <td width=\"50%\">\n        <div class=\"lbl\">Accepted By</div>\n        <div class=\"muted\">{{ doc.customer_name or doc.party_name }}</div>\n      </td>\n      <td width=\"50%\" class=\"r\">\n        <div class=\"lbl\">Signature</div>\n        <div class=\"muted\">{{ doc.company }}</div>\n      </td>\n    </tr>\n  </table>\n\n  <table class=\"sp\"><tr><td></td></tr></table>\n  <table class=\"rule\"><tr><td></td></tr></table>\n  <table class=\"sp\"><tr><td></td></tr></table>\n\n  <table>\n    <tr>\n      <td width=\"50%\">\n        <div class=\"lbl\">Contact</div>\n        <div class=\"muted\">\n          {% if doc.contact_display %}{{ doc.contact_display }}<br>{% endif %}\n          {% if doc.contact_mobile %}{{ doc.contact_mobile }}<br>{% endif %}\n          {% if doc.contact_email %}{{ doc.contact_email }}{% endif %}\n        </div>\n      </td>\n      <td width=\"50%\"></td>\n    </tr>\n  </table>\n\n</div>",
