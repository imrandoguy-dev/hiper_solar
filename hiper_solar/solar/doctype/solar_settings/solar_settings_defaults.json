 "features": [
  {
   "feature": "Create Customer when Quotation is submitted",
   "description": "Submitting a Quotation made for a Lead creates the Customer automatically. (Rightimage instead creates it at Order Confirmation.)",
   "client_scripts": "",
   "server_scripts": "Quotation - Create Customer on Submit"
  },
  {
   "feature": "Commissioning Checklist",
   "description": "Checklist on Project Commission and Customer, and blocks saving a commission without photo/document evidence.",
   "client_scripts": "Customer Commissioning Checklist\nProject Commission - Commissioning Checklist",
   "server_scripts": "Project Commission - Enforce Commissioning Evidence"
  },
  {
   "feature": "Referral Partner Program",
   "description": "Referral partners on Leads, commission on Quotation / Sales Order / Invoice, partner dashboard and commission payments.",
   "client_scripts": "Quotation - Referral Commission\nReferral Partner - Commission Rules\nReferral Partner - Full Width Performance\nReferral Partner Dashboard - Full Width Layout\nReferral Partner Dashboard - Page\nReferral Partner - Performance Dashboard\nReferral Commission - List\nReferral Partner - List\nReferral Settings - Reconcile\nReferral Commission Payment - Allocation\nLead - Referral Partner",
